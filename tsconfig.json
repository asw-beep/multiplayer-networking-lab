{
  "compilerOptions": {
    /* The BROWSER build: client/ + shared/ -> dist/.
       `types: []` deliberately blocks ambient @types/node from leaking in, so
       client code cannot quietly use a Node API that the browser lacks. */
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": [],

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true
  },
  "include": ["client/**/*.ts", "shared/**/*.ts"]
}
