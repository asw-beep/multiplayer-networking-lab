{
  "compilerOptions": {
    /* The NODE build: server/ + shared/ -> dist-server/.
       No "DOM" in lib, so server code cannot reach for `document` or `window`
       even by accident. That is plan Rule 5 enforced by the compiler rather
       than by good intentions. */
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],

    "rootDir": ".",
    "outDir": "dist-server",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"]
}
